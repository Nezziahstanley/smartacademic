{
  "name": "smartacademic",
  "version": "1.0.0",
  "description": "Academic Early-Warning System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "kill": "node scripts/kill-port.js 5000",
    "init-db": "node scripts/init-db.js",
    "seed-db": "node scripts/seed-db.js",
    "reset-db": "node scripts/reset-db.js",
    "run-risk": "node scripts/run-risk-engine.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit.test.js"
  },
  "dependencies": {
    "@emmanuelapabiekun/termii": "^0.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": ["<rootDir>/tests/setup.js"],
    "testMatch": ["<rootDir>/tests/**/*.test.js"]
  }
}